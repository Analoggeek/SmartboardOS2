{
  "name": "SmartBoardOS \u2014 Interactive Classroom Board",
  "short_name": "SmartBoardOS",
  "description": "An offline classroom workspace with whiteboard, Document Studio, Map Atlas and Smart Lab.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "fullscreen",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#060913",
  "theme_color": "#0b1020",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Whiteboard",
      "short_name": "Board",
      "description": "Start drawing straight away",
      "url": "./?app=whiteboard",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Class Tools",
      "short_name": "Tools",
      "description": "Picker, timer, scoreboard",
      "url": "./?app=class",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Map Atlas",
      "short_name": "Atlas",
      "description": "Explore offline geography maps",
      "url": "./?app=maps",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
