{
  "name": "smartboardos",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "SmartBoardOS — an offline whiteboard and classroom workspace.",
  "scripts": {
    "dev": "node scripts/preview.cjs",
    "start": "node scripts/preview.cjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "test": "node --test"
  },
  "keywords": [
    "whiteboard",
    "smartboard",
    "education",
    "pwa",
    "pdf",
    "teacher"
  ],
  "license": "MIT",
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "author": "SmartBoardOS contributors"
}
